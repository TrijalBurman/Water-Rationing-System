{
  "id": null,
  "uid": "water-rationing",
  "title": "Waterwise \u00b7 Operations Flight Recorder",
  "description": "Tank reserve, branch leaks, valve commands and JSN-SR04T health. Data arrives once per second; this dashboard refreshes every five seconds.",
  "tags": [
    "waterwise",
    "water",
    "operations"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Source",
        "type": "custom",
        "hide": 0,
        "query": "demo,hardware,api",
        "multi": false,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": "demo",
          "value": "demo"
        },
        "options": [
          {
            "selected": true,
            "text": "demo",
            "value": "demo"
          },
          {
            "selected": false,
            "text": "hardware",
            "value": "hardware"
          },
          {
            "selected": false,
            "text": "api",
            "value": "api"
          }
        ]
      },
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "waterwise-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(\n  bucket: v.defaultBucket,\n  tag: \"device_id\",\n  predicate: (r) => r._measurement == \"water_telemetry\" and r.source == \"${source}\",\n  start: -30d\n)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {
          "selected": true,
          "text": "tank-01",
          "value": "tank-01"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Tank Water Level",
      "type": "gauge",
      "description": "JSN-SR04T tank level. The protected reserve starts below 10%.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "waterwise-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "waterwise-influx"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"water_telemetry\" and r.source == \"${source}\")\n  |> filter(fn: (r) => r.device_id == \"${device}\")\n  |> filter(fn: (r) => r._field == \"level_percent\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"_field\", \"flat_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "Awaiting telemetry",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "yellow",
                "value": 25
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          },
          "mappings": [],
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 2,
      "title": "Usable Water Volume",
      "type": "stat",
      "description": "Current stored volume. Protected reserve is 20 L for the default 200 L tank (10% of configured capacity). Subtract the reserve to obtain deliverable water.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "waterwise-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "waterwise-influx"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"water_telemetry\" and r.source == \"${source}\")\n  |> filter(fn: (r) => r.device_id == \"${device}\")\n  |> filter(fn: (r) => r._field == \"volume_l\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"_field\", \"flat_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "liters",
          "decimals": 1,
          "noValue": "Awaiting telemetry",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "blue",
                "value": 20
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^volume_l( .*)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Stored water \u00b7 reserve 20 L"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Dual Flow Mass Balance",
      "type": "timeseries",
      "description": "Supply into the monitored branch (Qin) and delivery out (Qout). These sensors bracket the same pipe segment; Qin is not tank refill.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "waterwise-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "waterwise-influx"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"water_telemetry\" and r.source == \"${source}\")\n  |> filter(fn: (r) => r.device_id == \"${device}\")\n  |> filter(fn: (r) => r._field == \"flow_lpm\" or r._field == \"flow_out_lpm\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"_field\", \"flat_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "litre/min",
          "decimals": 1,
          "noValue": "Awaiting telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^flow_lpm( .*)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Supply \u00b7 Qin"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "cyan"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^flow_out_lpm( .*)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Delivery \u00b7 Qout"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "Pipeline Leak Differential",
      "type": "timeseries",
      "description": "Measured supply minus delivery alongside the controller threshold: max(0.3 L/min, 15% of supply). An alert requires three consecutive breaches. The dashed static marker shows the 0.3 L/min minimum.",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "waterwise-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "waterwise-influx"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"water_telemetry\" and r.source == \"${source}\")\n  |> filter(fn: (r) => r.device_id == \"${device}\")\n  |> filter(fn: (r) => r._field == \"leak_rate_lpm\" or r._field == \"leak_threshold_lpm\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"_field\", \"flat_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "litre/min",
          "decimals": 1,
          "noValue": "Awaiting telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          },
          "mappings": [],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^leak_rate_lpm( .*)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Measured differential"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^leak_threshold_lpm( .*)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Active leak threshold"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "title": "Depletion ETA",
      "type": "stat",
      "description": "Minutes until the 10% reserve, using five rolling supply-flow readings. No current ETA is shown when consumption is zero or the sensor is faulty.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "waterwise-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "waterwise-influx"
          },
          "query": "latest = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"water_telemetry\" and r.source == \"${source}\" and r.device_id == \"${device}\" and r._field == \"level_percent\")\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> findRecord(fn: (key) => true, idx: 0)\nlatestETA = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"water_telemetry\" and r.source == \"${source}\" and r.device_id == \"${device}\" and r._field == \"eta_minutes\")\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> findRecord(fn: (key) => true, idx: 0)\nfrom(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"water_telemetry\" and r.source == \"${source}\" and r.device_id == \"${device}\" and r._field == \"eta_minutes\")\n  |> filter(fn: (r) => exists latest._time and exists latestETA._time and latest._time == latestETA._time)\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"_field\", \"flat_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "noValue": "No finite ETA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "green",
                "value": 120
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "Valve Actuator Commands",
      "type": "bargauge",
      "description": "Independent master and branch commands. An ON/OFF solenoid applies each percentage as a 30-second duty cycle.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "waterwise-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "waterwise-influx"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"water_telemetry\" and r.source == \"${source}\")\n  |> filter(fn: (r) => r.device_id == \"${device}\")\n  |> filter(fn: (r) => r._field == \"master_valve_percent\" or r._field == \"flat_valve_percent\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"_field\", \"flat_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "Awaiting telemetry",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          },
          "mappings": [],
          "min": 0,
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^master_valve_percent( .*)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Master valve"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^flat_valve_percent( .*)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Flat valve"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "minVizHeight": 16,
        "minVizWidth": 0
      }
    },
    {
      "id": 7,
      "title": "Flight Mode Indicator",
      "type": "state-timeline",
      "description": "Overall, tank and branch states are separate rows. Branch leaks leave the master supply available unless reserve protection requires closure.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 16,
        "h": 7
      },
      "datasource": {
        "type": "influxdb",
        "uid": "waterwise-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "waterwise-influx"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"water_telemetry\" and r.source == \"${source}\")\n  |> filter(fn: (r) => r.device_id == \"${device}\")\n  |> filter(fn: (r) => r._field == \"mode\" or r._field == \"tank_mode\" or r._field == \"flat_status\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"_field\", \"flat_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "Awaiting telemetry",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "NORMAL": {
                  "text": "NORMAL",
                  "color": "green",
                  "index": 0
                },
                "WARNING": {
                  "text": "WARNING",
                  "color": "yellow",
                  "index": 1
                },
                "RATIONING": {
                  "text": "RATIONING",
                  "color": "orange",
                  "index": 2
                },
                "CRITICAL": {
                  "text": "CRITICAL",
                  "color": "red",
                  "index": 3
                },
                "SENSOR_FAULT": {
                  "text": "SENSOR FAULT",
                  "color": "red",
                  "index": 4
                },
                "SUSPECTED_LEAK": {
                  "text": "SUSPECTED LEAK",
                  "color": "yellow",
                  "index": 5
                },
                "LEAK_ALERT": {
                  "text": "LEAK ALERT",
                  "color": "red",
                  "index": 6
                },
                "OK": {
                  "text": "OK",
                  "color": "green",
                  "index": 7
                }
              }
            }
          ],
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 90,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^mode( .*)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Overall mode"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^tank_mode( .*)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Tank state"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^flat_status( .*)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Branch state"
              }
            ]
          }
        ]
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "title": "Sensor Health & Echo Distance",
      "type": "stat",
      "description": "Latest JSN-SR04T echo distance and backend sensor health. Valid echo bounds are 20\u2013600 cm. Fault status is shown in red; the protected reserve still takes precedence.",
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "influxdb",
        "uid": "waterwise-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "waterwise-influx"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"water_telemetry\" and r.source == \"${source}\")\n  |> filter(fn: (r) => r.device_id == \"${device}\")\n  |> filter(fn: (r) => r._field == \"ultrasonic_distance_cm\" or r._field == \"sensor_status\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"_field\", \"flat_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "Awaiting telemetry",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^ultrasonic_distance_cm( .*)?$"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Echo distance"
              },
