# Generate credentials with scripts/bootstrap.cmd (Windows) or scripts/bootstrap.sh. Do not commit .env.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
APP_MODE=demo
DEMO_AUTOSTART=true
API_KEY=
DAILY_QUOTA_L=150
TANK_CAPACITY_L=2.5
QUOTA_TIMEZONE=Asia/Kolkata

# Set 0.0.0.0 only when your ESP32 needs access over a trusted local network.
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=backend
MQTT_PASSWORD=
MQTT_DEVICE_PASSWORD=

INFLUX_BIND_ADDRESS=127.0.0.1
INFLUX_PORT=8086
INFLUX_ADMIN_USER=waterwise
INFLUX_ADMIN_PASSWORD=
INFLUX_ORG=waterwise
INFLUX_BUCKET=water_telemetry
INFLUX_TOKEN=
INFLUX_RETENTION=30d

GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
